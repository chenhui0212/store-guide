# --- Model ---
CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=sk-xxxx

DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VLM_MODEL=qwen3-vl-plus

# --- Embedding ---
EMBEDDING_MODEL=/Users/xxx/.models/bge-m3
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=False

# --- Milvus ---
MILVUS_URI=http://localhost:19530
MILVUS_DATABASE=store_guide
MILVUS_ITEM_NAME_COLLECTION=kb_item_names
MILVUS_CHUNK_COLLECTION=kb_chunks

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=store-guide
MINIO_SECURE=False

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j-dev
NEO4J_DATABASE=store-guide

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=store-guide
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/store-guide

# ============ 业务参数 ============

# --- 文档切分 ---
SUPPORTED_EXTENSIONS=.pdf,.docx
MAX_FILE_SIZE=20MB

CHUNK_SIZE=1000
CHUNK_OVERLAP=0

# --- 产品名识别 ---
ITEM_NAME_MAX_CHUNKS=5
ITEM_NAME_MAX_CONTEXT_CHARS=3000
